#!/bin/sh
# DeckPort AppImage entry point. No arguments: open the UI in its own window.
# With arguments it behaves like the CLI, e.g. `DeckPort.AppImage update`.
HERE="$(dirname "$(readlink -f "$0")")"

if ! command -v python3 >/dev/null 2>&1; then
  msg="DeckPort needs Python 3, which was not found on this system."
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --error "$msg"
  elif command -v zenity >/dev/null 2>&1; then
    zenity --error --text="$msg"
  else
    echo "$msg" >&2
  fi
  exit 1
fi

if [ "$#" -eq 0 ]; then
  set -- serve --window --exit-when-closed
fi
exec python3 "$HERE/usr/share/deckport/deckport.py" "$@"
