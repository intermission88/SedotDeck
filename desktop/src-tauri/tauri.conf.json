{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SedotDeck",
  "version": "0.0.1-alpha",
  "identifier": "io.github.intermission88.sedotdeck",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Utility",
    "shortDescription": "Update AppImages and PC ports from GitHub, GitLab, Codeberg and more",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "../../sedotdeck.py": "sedotdeck.py"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
